<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="90" android:startColor="#0B66FF" android:endColor="#38BDF8"/>
            <stroke android:width="2dp" android:color="#A7E6FF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="90" android:startColor="#0B66FF" android:endColor="#2B8CFF"/>
            <stroke android:width="2dp" android:color="#A7E6FF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#66305A91"/>
            <stroke android:width="1dp" android:color="#805A8FD1"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</selector>
